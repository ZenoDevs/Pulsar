# Basta una delle due chiavi (Anthropic consigliato per i dossier, OpenAI anche per gli embedding)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Voce del briefing (opzionale)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Database (docker compose lo imposta da solo)
# DATABASE_URL=postgresql://user:password@host:5432/postgres
POSTGRES_PASSWORD=cambiami

# auto = demo finche' non c'e' un'edizione reale
PULSAR_DEMO=auto
# URL pubblico (per CORS)
PULSAR_PUBLIC_URL=http://localhost:8000
